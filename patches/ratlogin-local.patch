+#[tokio::test]
+async fn the_profile_picture_reaches_the_id_token_and_userinfo() -> TestResult {
+    let state = fixture()?;
+    let code = state.flows.issue_code(AuthorizationCode {
+        avatar: Some("https://cdn.example/avatar.jpg".to_owned()),
+        ..code_record()?
+    })?;
+    let (status, _, body) = redeem(router(Arc::clone(&state)), &code, "").await?;
+    assert_eq!(status, StatusCode::OK, "{body}");
+    let response: serde_json::Value = serde_json::from_str(&body)?;
+    let claims = jwt_payload(response["id_token"].as_str().ok_or("missing id_token")?)?;
+    assert_eq!(claims["picture"], "https://cdn.example/avatar.jpg");
+    let access_token = response["access_token"].as_str().ok_or("missing token")?;
+    let (status, _, body) = userinfo(&state, &format!("Bearer {access_token}")).await?;
+    assert_eq!(status, StatusCode::OK, "{body}");
+    let claims: serde_json::Value = serde_json::from_str(&body)?;
+    assert_eq!(claims["picture"], "https://cdn.example/avatar.jpg");
+    Ok(())
+}
