# Encrypt this template with `sops secrets/halo.yaml` once the host age keys
# are in place (see README). The placeholder values below map to the
# `sops.secrets.*` paths referenced by the modules.
#
# Secret                    Consumer(s)
# ----------------------------------------------------------------
# oidc/forgejo              ratlogin client + Forgejo OIDC source
# oidc/vikunja              ratlogin client + Vikunja OIDC provider
# oidc/oauth2-proxy         ratlogin client + protected admin/request sites
# oauth2-proxy/cookie-secret  16, 24, or 32-byte oauth2-proxy cookie key
# oauth2-proxy/backend-secret  private proxy-to-portal credential
# pds-env                   tranquil-pds environment (JWT/DPoP/master keys, mail, S3)
# searx-env                 searx service (SEARX_SECRET_KEY)
# garage/rpc-secret         garage RPC secret (GARAGE_RPC_SECRET)
# garage/s3-access          hold -> garage S3 access key
# garage/s3-secret          hold -> garage S3 secret key
# hold/rotation-key         hold database rotation key
# route/api-key             route.daze.lol API key (CLIProxyAPI + Open WebUI)
# openrouter/api-key        OpenRouter provider key (kept out of Open WebUI)
# openrouter/proxy-key      internal Open WebUI -> ZDR proxy bearer key
# cloudflare/email-routing  multi-line env: CF_EMAIL_TOKEN, CF_ACCOUNT_ID,
#                           CF_ZONE_ID, EMAIL_DOMAIN=daze.lol (per-user forwards)
# cloudflare/tunnel-credentials  cloudflared credentials JSON for halo-llama
# acme/cloudflare           Cloudflare API token (DNS-01 for irc.daze.lol)

oidc:
  forgejo: CHANGE_ME
  vikunja: CHANGE_ME
  oauth2-proxy: CHANGE_ME
oauth2-proxy:
  cookie-secret: 0123456789abcdef0123456789abcdef
  backend-secret: CHANGE_ME
pds-env: CHANGE_ME
searx-env: CHANGE_ME
garage:
  rpc-secret: CHANGE_ME
  s3-access: CHANGE_ME
  s3-secret: CHANGE_ME
hold:
  rotation-key: CHANGE_ME
route:
  api-key: CHANGE_ME
openrouter:
  api-key: CHANGE_ME
  proxy-key: CHANGE_ME
cloudflare:
  email-routing: |-
    CF_EMAIL_TOKEN=CHANGE_ME
    CF_ACCOUNT_ID=CHANGE_ME
    CF_ZONE_ID=CHANGE_ME
    EMAIL_DOMAIN=daze.lol
  tunnel-credentials: '{"AccountTag":"CHANGE_ME","TunnelID":"CHANGE_ME","TunnelSecret":"CHANGE_ME"}'
acme:
  cloudflare: CHANGE_ME
